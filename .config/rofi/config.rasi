// @import "catppuccin-latte"
// @import "catppuccin-frappe"
// @import "catppuccin-macchiato"
 @import "catppuccin-mocha"

* {
  selected-active-foreground:  @base;
  lightfg:                     @text;
  separatorcolor:              @mauve;
  urgent-foreground:           @base;
  alternate-urgent-background: @red;
  lightbg:                     @base;
  background-color:            @base;
  border-color:                @mauve;
  normal-background:           @base;
  selected-urgent-background:  @red;
  alternate-active-background: @pink;
  spacing:                     0.5em;
  alternate-normal-foreground: @text;
  urgent-background:           @red;
  selected-normal-foreground:  @base;
  active-foreground:           @base;
  background:                  @base;
  selected-active-background:  @mauve;
  active-background:           @pink;
  selected-normal-background:  @mauve;
  alternate-normal-background: @base;
  foreground:                  @text;
  selected-urgent-foreground:  @text;
  normal-foreground:           @text;
  alternate-urgent-foreground: @text;
  alternate-active-foreground: @base;
  font : "JetBrains Mono 12";

}




element {
  children: [ textbox-marker, element-text ];
}



textbox-marker {
    padding:0 0.25em;
    content: ">";
    expand: false;
    vertical-align: 0.5;
    text-color: @base;
    background-color:transparent;
    color:transparent;
}

textbox-marker selected{
    background-color: @mauve;
    color:@base;
}

element normal.normal {
  background-color: @normal-background;
  text-color:       @normal-foreground;
}
element normal.urgent {
  background-color: @urgent-background;
  text-color:       @urgent-foreground;
}
element normal.active {
  background-color: @active-background;
  text-color:       @active-foreground;
}
element selected.normal {
  background-color: @selected-normal-background;
  text-color:       @selected-normal-foreground;
}
element selected.urgent {
  background-color: @selected-urgent-background;
  text-color:       @selected-urgent-foreground;
}
element selected.active {
  background-color: @selected-active-background;
  text-color:       @selected-active-foreground;
}
element alternate.normal {
  background-color: @alternate-normal-background;
  text-color:       @alternate-normal-foreground;
}
element alternate.urgent {
  background-color: @alternate-urgent-background;
  text-color:       @alternate-urgent-foreground;
}
element alternate.active {
  background-color: @alternate-active-background;
  text-color:       @alternate-active-foreground;
}
element-text {
  background-color: transparent;
  cursor:           inherit;
  highlight:        inherit;
  text-color:       inherit;
  vertical-align: 0.5;
  size: 1;
}
element-icon {
  background-color: transparent;
  size:             0.0000em ;
  cursor:           inherit;
  text-color:       inherit;
}
window {
  padding:          0.5em;
  background-color: @background;
  border:           2px;
  width: 33em;
  height: 25em;
  border-radius: 0;
  children : ["message","listview","inputbar"];
}
mainbox {
  padding: 0;
}
message {
  padding:      0.5em 1em ;
  border-color: @separatorcolor;
  border:       2px ;

}
textbox {
  border : 0px;
  text-color: @foreground;
}
listview {
  padding:      0.4em 0.4em;
  scrollbar:    false;
  border-color: @separatorcolor;
  fixed-height: 0;
  border : 2px;
  columns: 1;
}
scrollbar {
  width:        4px ;
  padding:      0;
  handle-width: 8px ;
  border:       0;
  handle-color: @mauve;
  background-color: @alternate-normal-background;
}
sidebar {
  border-color: @separatorcolor;
  border:       0px 0px 0px 0px ;
}
button {
  cursor:     pointer;
  text-color: @normal-foreground;
}
button selected {
  background-color: @selected-normal-background;
  text-color:       @selected-normal-foreground;
}
num-filtered-rows {
  expand:     false;
  text-color: @text;
}
num-rows {
  expand:     false;
  text-color: @text;
}
textbox-num-sep {
  expand:     false;
  str:        "/";
  text-color: @text;
}
inputbar {
  border: 2px;
  padding:    0.5em 1em ;
  text-color: @normal-foreground;
  children:   ["prompt","textbox-prompt-colon","entry","num-filtered-rows","textbox-num-sep","num-rows","case-indicator" ];
}
case-indicator {
  text-color: @normal-foreground;
}
entry {
  text-color:        @normal-foreground;
  cursor:            text;
  placeholder-color: @overlay0;
}
prompt {
  text-color: @normal-foreground;
}
textbox-prompt-colon {
  margin:     0px 0.3000em 0.0000em 0.0000em ;
  expand:     false;
  str:        ":";
  text-color: inherit;
}
mode-switcher {
  border: 2px;
  padding: 0.5em 1em;
  index: 10;
  }



configuration {
	modes: "window,drun,run,ssh";
	show-icons:true;
	terminal:"kitty";
}
